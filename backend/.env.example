# Python backend only. Never commit a real .env file.
APP_ENV=development
DATABASE_URL=postgres://agentsdr:change-me@localhost:5432/agentsdr

# Internal token used while the Next.js frontend and Python backend run in
# parallel. Replace it with the final session-based auth before exposing the API.
AGENT_BACKEND_TOKEN=change-me

# DeepSeek / OpenAI-compatible model. Leave empty to use deterministic fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# QCC Open Platform. Leave empty to return an explicit empty local result.
QCC_APP_KEY=
QCC_SECRET_KEY=
QCC_BASE_URL=https://api.qichacha.com

# QCC MCP powers optional gray-zone deep checks. Keep both Agent switches off
# until the QCC account and tool permissions have been verified.
QCC_MCP_TOKEN=
QCC_MCP_BASE_URL=https://agent.qcc.com/mcp
AGENT_REPLAN_SEARCH=false
AGENT_QUALIFY_GRAY_ZONE=false

# LangSmith is optional. Tracing only starts when both TRACING=true and an API
# key are present. The API key must never be exposed to the frontend.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentsdr-dev
# Leave empty for the default US endpoint. Set the workspace-specific URL only
# when your LangSmith organization uses another region.
LANGSMITH_ENDPOINT=
# Hard privacy switches. Set both to true when trace content must not leave the
# deployment, while still keeping timing and error metadata in LangSmith.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# Comma-separated browser origins allowed to call the Python API directly.
CORS_ORIGINS=http://localhost:3000
